{
  "name": "x4-station-calculator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --base /",
    "wdev": "portless proxy start -p 1355 && python3 scripts/worktree-server.py",
    "build": "node scripts/check-production-compat.mjs && vue-tsc -b && vite build",
    "full-build": "node scripts/check-production-compat.mjs && rm -rf node_modules/.tmp/tsconfig.app.tsbuildinfo && vue-tsc -b && vite build",
    "build-rust": "cd rust-parser && ./build.sh",
    "preview": "vite preview",
    "test:e2e": "npm exec playwright test",
    "test:unit": "vitest run",
    "test:e2e:ui": "npm exec playwright test --ui",
    "test:e2e:debug": "npm exec playwright test --debug",
    "playwright:install": "npm exec playwright install",
    "mockdata": "tsx scripts/mockDataGenerator.ts"
  },
  "dependencies": {
    "@floating-ui/vue": "^2.0.0",
    "@heroicons/vue": "^2.2.0",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/sax": "^1.2.7",
    "autoprefixer": "^10.4.24",
    "culori": "^4.0.2",
    "dexie": "^4.4.2",
    "fast-xml-parser": "^5.5.6",
    "getopts": "^2.3.0",
    "js-cookie": "^3.0.5",
    "pinia": "^3.0.4",
    "pinyin-pro": "^3.28.0",
    "playwright": "^1.57.0",
    "sax": "^1.6.0",
    "sax-wasm": "^3.1.4",
    "tailwindcss": "^3.4.19",
    "tippy.js": "^6.3.7",
    "vue": "^3.5.24",
    "vue-color": "^3.3.3",
    "vue-i18n": "^11.2.8",
    "vue-tippy": "^6.7.1",
    "vuedraggable": "^4.1.0",
    "yaml": "^2.8.2"
  },
  "optionalDependencies": {
    "@esbuild/darwin-x64": "^0.27.3",
    "@esbuild/linux-x64": "^0.27.3"
  },
  "devDependencies": {
    "@pinia/testing": "^1.0.3",
    "@types/js-cookie": "^3.0.6",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^24.10.9",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "jsdom": "^28.0.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vite-node": "^6.0.0",
    "vitest": "^4.0.18",
    "vue-tsc": "^3.2.4",
    "xml-formatter": "^3.7.0"
  }
}
